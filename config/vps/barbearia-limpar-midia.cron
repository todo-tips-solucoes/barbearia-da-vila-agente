# Barbearia da Vila: apaga o audio que o n8n grava em disco no interpretar_midia (TESTE e PROD),
# pois ele nao expurga binaryData sozinho (research.md, sonda 2.3). Instalar em /etc/cron.d/.
# O container e achado pelo nome do servico do Swarm (bv_n8n), que sorteia o nome. Uma linha por ambiente: TESTE (y71ufji64xT2cTaW) e PROD (IiVgK4hASaCzzbVM, criado em 2026-10-21).
*/5 * * * * root docker exec $(docker ps -q -f name=bv_n8n. -f status=running | head -1) sh -c 'd=/home/node/.n8n/binaryData/workflows/y71ufji64xT2cTaW; [ -d "$d" ] && find "$d" -type f -mmin +10 -delete && find "$d" -mindepth 1 -type d -empty -delete' >/dev/null 2>&1
*/5 * * * * root docker exec $(docker ps -q -f name=bv_n8n. -f status=running | head -1) sh -c 'd=/home/node/.n8n/binaryData/workflows/IiVgK4hASaCzzbVM; [ -d "$d" ] && find "$d" -type f -mmin +10 -delete && find "$d" -mindepth 1 -type d -empty -delete' >/dev/null 2>&1
