# Barbearia da Vila: apaga o audio que o n8n2 grava em disco no interpretar_midia (TESTE e PROD),
# pois ele nao expurga binaryData sozinho (research.md, sonda 2.3). Instalar em /etc/cron.d/.
# Uma linha por ambiente: TESTE (FbQLbUHauxMMIjI4) e PROD (IiVgK4hASaCzzbVM, criado em 2026-10-21).
*/5 * * * * root docker exec n8n-n8n-1 sh -c 'd=/home/node/.n8n/binaryData/workflows/FbQLbUHauxMMIjI4; [ -d "$d" ] && find "$d" -type f -mmin +10 -delete && find "$d" -mindepth 1 -type d -empty -delete' >/dev/null 2>&1
*/5 * * * * root docker exec n8n-n8n-1 sh -c 'd=/home/node/.n8n/binaryData/workflows/IiVgK4hASaCzzbVM; [ -d "$d" ] && find "$d" -type f -mmin +10 -delete && find "$d" -mindepth 1 -type d -empty -delete' >/dev/null 2>&1
