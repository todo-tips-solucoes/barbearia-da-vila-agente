{
  "source": "https://api.gracesonline.com.br/docs/",
  "api_base": {
    "producao": "https://api.gracesonline.com.br/public/v1",
    "homologacao": "https://api-staging.gracesonline.com.br/public/v1"
  },
  "fetched": "2026-10-18",
  "auth": { "header": "X-Api-Key", "env": "GRACES_API_KEY", "validar": "GET /auth/validar", "observacao": "chave atual so vale em producao (staging responde 401)" },
  "pagination": { "query": ["pageNumber", "pageSize"], "default_page_size": 50, "max_page_size": 200, "response_header": "X-Pagination" },
  "errors": { "format": "ProblemDetails (RFC 7807)", "fields": ["type", "title", "status", "detail", "instance", "code", "traceId"],
    "codes": { "400": ["PARAMETRO_INVALIDO", "CORPO_INVALIDO"], "401": ["NAO_AUTENTICADO"], "403": ["LOJA_FORA_ESCOPO", "ACESSO_NEGADO"], "404": ["NAO_ENCONTRADO"], "409": ["CONFLITO"] } },
  "status_agenda": { "2": "A confirmar", "3": "Confirmado", "9": "Não compareceu", "10": "Não confirmado" },
  "endpoints": [
    { "id": "listar-servicos", "method": "GET", "path": "/agenda/servicos", "doc": "01-servicos-e-profissionais.md",
      "query": { "texto": { "type": "string", "required": false, "desc": "filtro pela descrição, 3+ caracteres" } },
      "response": "array<{idServico, descricaoAgenda, tempoPadrao:int(min), valorPadrao, ativo}>" },
    { "id": "profissionais-do-servico", "method": "GET", "path": "/servicos/profissionais", "doc": "01-servicos-e-profissionais.md",
      "query": { "idServico": { "type": "guid", "required": true } },
      "response": "array<{idProfissional, apelido, nomeCompleto, funcao}>" },
    { "id": "buscar-clientes", "method": "GET", "path": "/agenda/clientes", "doc": "02-clientes.md", "paginated": true,
      "query": { "celular": { "type": "string", "required": "um de celular|busca" }, "busca": { "type": "string", "required": "um de celular|busca", "desc": "nome, 3+ caracteres" }, "pageNumber": { "type": "integer" }, "pageSize": { "type": "integer" } },
      "response": "array<{idCliente, nomeCliente, sobrenomeCliente, razaoSocial, email, documento, ddiCelular, celular, numeroCadastro, dataNascimento}>" },
    { "id": "cadastrar-cliente", "method": "POST", "path": "/agenda/clientes", "doc": "02-clientes.md", "writes": true,
      "body": { "nomeCliente": { "type": "string", "required": true }, "documento": { "type": "string" }, "ddiCelular": { "type": "string", "required": "se celular" }, "celular": { "type": "string", "required": "na loja: sim (CelularObrigatorio)" }, "ddiTelefone": { "type": "string", "required": "se telefone" }, "telefone": { "type": "string" }, "email": { "type": "string" }, "dataNascimento": { "type": "string", "format": "AAAA-MM-DD" }, "genero": { "type": "string" }, "apelido": { "type": "string" }, "rg": { "type": "string" } },
      "response": "{sucesso, idCliente, mensagem}" },
    { "id": "configuracao-cadastro-cliente", "method": "GET", "path": "/agenda/clientes/configuracao", "doc": "02-clientes.md",
      "response": "array<{idConfiguracaoEmpresa, idEmpresa, valor:string, chaveConfiguracao:{chave, descricao}}>" },
    { "id": "horarios-livres", "method": "GET", "path": "/agenda/horarios-livres", "doc": "03-disponibilidade-e-configuracao.md",
      "query": { "idServico": { "type": "guid", "required": true }, "idProfissional": { "type": "guid", "required": true }, "data": { "type": "string", "required": true, "format": "AAAA-MM-DD" } },
      "response": "{data, minutos, origemMinutos, intervaloMinutos, funcionamento:{horaInicio, horaFim}, horarios:string[HH:mm]}" },
    { "id": "ocupacoes", "method": "GET", "path": "/agenda/horarios", "doc": "03-disponibilidade-e-configuracao.md",
      "query": { "idServico": { "type": "guid", "required": true }, "idProfissional": { "type": "guid", "required": true }, "data": { "type": "string", "required": true, "format": "AAAA-MM-DD" } },
      "response": "{data, minutos, horarios:array<{horaInicio, horaFim, tipo:1=agendamento|2=bloqueio}>}" },
    { "id": "configuracao-agenda", "method": "GET", "path": "/agenda/configuracao", "doc": "03-disponibilidade-e-configuracao.md",
      "response": "{prazoMinimoAntecedencia:int(min), prazoMaximo:int(dias), horarios:array<{dia:string, horaInicio, horaFim}>}" },
    { "id": "agendamentos-do-cliente", "method": "GET", "path": "/agenda/agendamentos", "doc": "04-agendamentos.md", "paginated": true,
      "query": { "idCliente": { "type": "guid", "required": true }, "proximos": { "type": "boolean", "default": true }, "pageNumber": { "type": "integer" }, "pageSize": { "type": "integer" } },
      "response": "array<{idAgenda, horaInicio, horaFim, idServico, descricaoServico, idProfissional, profissional, idStatusAgenda, status, recorrente, servicoPacote}>" },
    { "id": "criar-agendamento", "method": "POST", "path": "/agenda", "doc": "04-agendamentos.md", "writes": true,
      "body": { "idCliente": { "type": "guid", "required": true }, "idServico": { "type": "guid", "required": "xor idClienteItemPacote" }, "idClienteItemPacote": { "type": "guid", "required": "xor idServico" }, "idProfissional": { "type": "guid", "required": true }, "data": { "type": "string", "required": true, "format": "AAAA-MM-DD" }, "horaInicio": { "type": "string", "required": true, "format": "HH:mm" }, "idIntegracao": { "type": "string" } },
      "response": "{sucesso, idAgenda, mensagem, idIntegracao}" },
    { "id": "reagendar", "method": "PUT", "path": "/agenda/{idAgenda}", "doc": "04-agendamentos.md", "writes": true,
      "body": { "horaInicioOriginal": { "type": "string", "format": "AAAA-MM-DDTHH:mm:ss" }, "horaInicioNovo": { "type": "string", "format": "AAAA-MM-DDTHH:mm:ss" }, "idProfissional": { "type": "guid", "required": true } },
      "response": "{sucesso, idAgenda, mensagem}" },
    { "id": "cancelar", "method": "DELETE", "path": "/agenda/{idAgenda}", "doc": "04-agendamentos.md", "writes": true, "irreversible": true,
      "query": { "data": { "type": "string", "required": "se recorrente", "format": "AAAA-MM-DD" } },
      "response": "{sucesso, idAgenda, mensagem}" },
    { "id": "confirmar-presenca", "method": "POST", "path": "/agenda/confirmacao", "doc": "04-agendamentos.md", "writes": true,
      "body": { "idAgenda": { "type": "guid", "required": true }, "confirmado": { "type": "boolean", "required": true }, "data": { "type": "string", "required": "se recorrente", "format": "AAAA-MM-DD" } },
      "precondition": "idStatusAgenda == 2",
      "response": "{sucesso, idAgenda, idStatusAgenda, mensagem}" },
    { "id": "pacotes-do-cliente", "method": "GET", "path": "/agenda/pacotes", "doc": "04-agendamentos.md", "paginated": true,
      "query": { "idCliente": { "type": "guid", "required": true }, "idServico": { "type": "guid" }, "pageNumber": { "type": "integer" }, "pageSize": { "type": "integer" } },
      "response": "array<{idClientePacote, descricao, dataInclusao, dataValidade|null, secoes:array<{idClienteItemPacote, idProdutoServico, descricaoAgendaOnline}>}>" },
    { "id": "historico-do-cliente", "method": "GET", "path": "/agenda/historico", "doc": "04-agendamentos.md", "paginated": true,
      "query": { "idCliente": { "type": "guid", "required": true }, "pageNumber": { "type": "integer" }, "pageSize": { "type": "integer" } },
      "response": "array<{idComanda, numeroComanda, dataAbertura, idServico, descricaoServico, valorTotal, profissional}>" },
    { "id": "agenda-completa", "method": "GET", "path": "/agenda/completa", "doc": "04-agendamentos.md", "paginated": true,
      "query": { "dataInicio": { "type": "string", "required": true, "format": "AAAA-MM-DD" }, "dataFim": { "type": "string", "required": true, "format": "AAAA-MM-DD", "desc": "janela de ±7 dias de hoje" }, "pageNumber": { "type": "integer" }, "pageSize": { "type": "integer" } },
      "response": "array<{idProfissional, apelido, funcao, corColuna, agendamentos:array<{idAgenda, horaInicio, horaFim, idStatusAgenda, status, nomeCliente, ddiCelular, celularCliente, nomeServico}>}>" },
    { "id": "validar-chave", "method": "GET", "path": "/auth/validar", "doc": "00-autenticacao-e-erros.md", "response": "200 válida | 401 inválida" }
  ],
  "deprecated": [ { "method": "GET", "path": "/agenda/secao", "since": "2026-09-16", "use": "GET /agenda/pacotes" } ]
}
