{
  "name": "Barbearia Vila - Alerta fora de banda [{{BV:rotulo}}]",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": "{{BV:NUM:alerta.janela_min}}"
            }
          ]
        }
      },
      "id": "a1e7a000-0000-4000-8000-000000000001",
      "name": "A cada janela",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT count(*)::int AS falhas FROM falhas_agente WHERE motivo = 'agente_falhou' AND criado_em > now() - make_interval(mins => $1::int)",
        "options": {
          "queryReplacement": "={{ [{{BV:alerta.janela_min}}] }}"
        }
      },
      "id": "a1e7a000-0000-4000-8000-000000000002",
      "name": "Checar banco",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        240,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "{{BV:postgres.credencial_id}}",
          "name": "Postgres Barbearia Vila"
        }
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.chatmasterveloz.com/api/whatsapp-status",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": "{{BV:NUM:graces.timeout_ms}}"
        }
      },
      "id": "a1e7a000-0000-4000-8000-000000000005",
      "name": "Checar WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "{{BV:credenciais.chatmaster}}",
          "name": "Barbearia Vila Chat Master"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "{{BV:INCLUDE:shared/alerta.js}}\nconst cfg = { rotulo: '{{BV:rotulo}}', limiar: {{BV:alerta.falhas_agente_limiar}}, janela_min: {{BV:alerta.janela_min}}, repetir_min: {{BV:alerta.repetir_min}} };\nconst banco = $('Checar banco').first().json;\nconst falhas = banco.error ? null : banco.falhas;\n// a resposta do status traz dados de todas as conexoes da empresa: daqui so sai o estado da conexao da loja\nconst conexao = bvAlertaConexao($input.first().json, '{{BV:chatmaster.whatsapp_id}}');\nreturn bvAlertaFiltrar(bvAlertaDecidir(falhas, cfg, conexao), $getWorkflowStaticData('global'), Date.now(), cfg).map((a) => ({ json: a }));"
      },
      "id": "a1e7a000-0000-4000-8000-000000000003",
      "name": "Decidir",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "a1e7a000-0000-4000-8000-0000000000c1",
              "leftValue": "={{ String($json.reserva === true) }}",
              "rightValue": "true",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1e7a000-0000-4000-8000-000000000006",
      "name": "Pela reserva?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        960,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.chatmasterveloz.com/api/messages/send",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ number: '{{BV:alerta.contato}}', openTicket: '0', queueId: '{{BV:alerta.reserva.queue_id}}', whatsappId: '{{BV:alerta.reserva.whatsapp_id}}', body: $json.texto }) }}",
        "options": {
          "timeout": "{{BV:NUM:graces.timeout_ms}}"
        }
      },
      "id": "a1e7a000-0000-4000-8000-000000000007",
      "name": "Enviar pela reserva",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        -120
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "{{BV:credenciais.chatmaster_reserva}}",
          "name": "Barbearia Vila Chat Master (reserva)"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.chatmasterveloz.com/api/messages/send",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ number: '{{BV:alerta.contato}}', openTicket: '0', queueId: '{{BV:chatmaster.queue_id}}', whatsappId: '{{BV:chatmaster.whatsapp_id}}', body: $json.texto }) }}",
        "options": {
          "timeout": "{{BV:NUM:graces.timeout_ms}}"
        }
      },
      "id": "a1e7a000-0000-4000-8000-000000000004",
      "name": "Enviar alerta",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        120
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "{{BV:credenciais.chatmaster}}",
          "name": "Barbearia Vila Chat Master"
        }
      },
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
    "A cada janela": {
      "main": [
        [
          {
            "node": "Checar banco",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Checar banco": {
      "main": [
        [
          {
            "node": "Checar WhatsApp",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Checar WhatsApp": {
      "main": [
        [
          {
            "node": "Decidir",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Decidir": {
      "main": [
        [
          {
            "node": "Pela reserva?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Pela reserva?": {
      "main": [
        [
          {
            "node": "Enviar pela reserva",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Enviar alerta",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "all",
    "saveManualExecutions": false
  }
}
