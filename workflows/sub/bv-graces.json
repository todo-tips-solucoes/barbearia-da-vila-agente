        "operation": "executeQuery",
        "query": "WITH k AS (UPDATE propostas SET estado = 'executando', atualizada_em = now() WHERE id::text = $2::text AND contato_id = $1::bigint AND estado = 'pendente' AND turno_id::text <> $3::text AND acao = ANY(string_to_array($5::text, ',')) AND criada_em > now() - make_interval(mins => $4::int) RETURNING id::text AS id, acao, dados), i AS (SELECT estado, turno_id::text = $3::text AS mesmo_turno FROM propostas WHERE id::text = $2::text AND contato_id = $1::bigint) SELECT c.pedido, c.opcoes, (SELECT to_jsonb(k) FROM k) AS proposta, (SELECT to_jsonb(i) FROM i) AS info FROM (SELECT $1::bigint AS cid) x LEFT JOIN conversas c ON c.contato_id = x.cid",
        "options": {
          "queryReplacement": "={{ [$json.in.contato_id, $json.in.proposta_id || '', $json.in.turno_id, {{BV:proposta.validade_min}}, {\"agendar\": \"agendar,trocar_servico\", \"reagendar\": \"reagendar\", \"cancelar\": \"cancelar\"}[$json.in.operacao] || ''] }}"
        }
