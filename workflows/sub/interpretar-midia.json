        "jsCode": "const v = $('Conferir').item.json; const st = $json.statusCode; const ok = st >= 200 && st < 300;\nconst t = (typeof ($json.body || {}).text === 'string' ? $json.body.text : '' || '').trim();\nconst r = { idx: v.idx, contato_id: v.contato_id, mensagem_id: v.mensagem_id, tipo: v.tipo, texto: null, motivo: null, status_http: Number.isInteger(st) ? st : null, host: null };\nif (!ok) r.motivo = 'transcricao'; else if (!t) r.motivo = 'vazio'; else r.texto = t.slice(0, 4000);\nreturn { json: r };"
