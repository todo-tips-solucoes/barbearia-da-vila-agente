        "jsCode": "{{BV:INCLUDE:shared/midia.js}}\n{{BV:INCLUDE:shared/agente.js}}\nconst cfg = { hosts_audio: {{BV:midia.hosts_audio}}, hosts_imagem: {{BV:midia.hosts_imagem}}, prefixos_audio: {{BV:midia.prefixos_audio}}, prefixos_imagem: {{BV:midia.prefixos_imagem}}, mimes_audio: {{BV:midia.mimes_audio}}, mimes_imagem: {{BV:midia.mimes_imagem}}, audio_max_s: {{BV:midia.audio_max_s}}, audio_max_mb: {{BV:midia.audio_max_mb}}, imagem_max_mb: {{BV:midia.imagem_max_mb}}, max_por_turno: {{BV:midia.max_por_turno}}, descricao_max_chars: {{BV:midia.descricao_max_chars}}, imagem_detalhe: '{{BV:midia.imagem_detalhe}}', modelo: '{{BV:agente.modelo}}' };\nconst v = $json; const falha = (motivo, extra) => ({ json: { ...v, ok: false, motivo, ...(extra || {}) } });\nlet r; try { r = await this.helpers.httpRequest({ method: 'GET', url: v.midia_url, encoding: 'arraybuffer', returnFullResponse: true, ignoreHttpStatusErrors: true, disableFollowRedirect: true, timeout: {{BV:midia.download_timeout_s}} * 1000 }); } catch (e) { return falha('download'); }\nconst st = r.statusCode; if (!(st >= 200 && st < 300)) return falha('download', { status_http: Number.isInteger(st) ? st : null });\nconst buf = Buffer.from(r.body || []);\nif (buf.length === 0) return falha('vazio');\nif (buf.length > cfg.imagem_max_mb * 1024 * 1024) return falha('grande');\nconst mime = bvMimeBase((r.headers || {})['content-type']);\nif (!cfg.mimes_imagem.map((x) => x.toLowerCase()).includes(mime)) return falha('sem_suporte');\nreturn { json: { ...v, ok: true, corpo_imagem: JSON.stringify({ model: cfg.modelo, input: [{ role: 'user', content: [{ type: 'input_text', text: bvPromptImagem(cfg) }, { type: 'input_image', image_url: 'data:' + mime + ';base64,' + buf.toString('base64'), detail: cfg.imagem_detalhe }] }] }) } };"
