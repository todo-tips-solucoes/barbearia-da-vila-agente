    {
      "parameters": {
        "jsCode": "{{BV:INCLUDE:shared/mensagens.js}}\nconst textos = { confirmacao_ok: \"{{BV:textos.confirmacao_ok}}\", confirmacao_recusada: \"{{BV:textos.confirmacao_recusada}}\", confirmacao_repetida: \"{{BV:textos.confirmacao_repetida}}\",\n  confirmacao_desatualizada: \"{{BV:textos.confirmacao_desatualizada}}\", confirmacao_falhou: \"{{BV:textos.confirmacao_falhou}}\",\n  confirmacao_escolher: \"{{BV:textos.confirmacao_escolher}}\" };\n// tres origens: fim direto (Escolher / Resolver claim, com `ent`) ou resultado da Graces (Avaliar / Conferencia)\nconst i = $input.first().json;\nlet ent, row, code, status = 0, req = null;\nif (i.ent) { ent = i.ent; row = i.row || null; code = i.code; req = i.req || null; }\nelse { const b = $('Resolver claim').first().json; ent = b.ent; row = b.row || null; req = b.req; code = i.code; status = i.status || 0; }\nconst texto = bvMConfTexto(code, row, ent.origem, textos, {{BV:mensagens.repetida_max_por_hora}});\n// so contatos de escrita (teste.contatos_escrita) recebem de verdade; os simulados so tem a saida gravada em `mensagens`\nconst dig = (x) => String(x || '').replace(/\\D/g, '');\nconst simulado = '{{BV:ambiente}}' === 'integracao' && !{{BV:teste.contatos_escrita}}.map(dig).includes(dig(row && row.telefone));\n// desatualizada depois do claim (409 divergente): devolve a resposta e encerra a linha (motivo 'divergente'), sem novo claim\nconst encerrar = code === 'desatualizada' && !!req;\nconst falha = code === 'falhou' ? { motivo: 'mensagem|graces_confirmacao', code: status ? 'HTTP_' + status : 'SEM_RESPOSTA', status }\n  : code === 'fora_do_teste' ? { motivo: 'mensagem|fora_do_teste', code: 'FORA_DO_TESTE', status: 0 } : null;\nreturn [{ json: { ok: code === 'confirmada' || code === 'recusada' || code === 'repetida', code, texto, enviar: !!texto && ent.origem !== 'agente' && !simulado, simulado: !!texto && ent.origem !== 'agente' && simulado, falha,\n  id: row && row.id, idAgenda: req && req.idAgenda, recusada: code === 'recusada', liberar: code === 'falhou' || encerrar, encerrar, telefone: row && row.telefone, contato_id: ent.contato_id } }];"
      },
