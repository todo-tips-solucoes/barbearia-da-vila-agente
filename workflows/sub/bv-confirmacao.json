    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH rel AS (UPDATE mensagens_agendadas SET resposta = NULL, respondida_em = NULL, motivo = CASE WHEN $12::boolean THEN 'divergente' ELSE motivo END, atualizado_em = now() WHERE id = $1::bigint AND $2::boolean AND resposta IS NOT NULL RETURNING 1), rp AS (UPDATE mensagens_agendadas SET situacao = 'cancelada', motivo = 'recusada', atualizado_em = now() WHERE $8::boolean AND graces_agendamento_id = $7::text AND tipo IN ('lembrete', 'pos_atendimento') AND situacao = 'pendente' AND reservada_em IS NULL AND inicio = (SELECT inicio FROM mensagens_agendadas WHERE id = $1::bigint) RETURNING 1), fa AS (INSERT INTO falhas_agente (tipo, motivo, operacao, code, status_http, contato_id) SELECT 'mensagem', $3::text, 'confirmar', $4::text, $5::int, $6::bigint WHERE $3::text IS NOT NULL RETURNING 1), cv AS (INSERT INTO conversas (contato_id, pedido) SELECT $6::bigint, jsonb_build_object('confirmacao_recusada', jsonb_build_object('idAgenda', $7::text, 'em', now())) WHERE $8::boolean ON CONFLICT (contato_id) DO UPDATE SET pedido = conversas.pedido || EXCLUDED.pedido, atualizado_em = now() RETURNING 1), ms AS (INSERT INTO mensagens (contato_id, mensagem_id_canal, direcao, tipo, conteudo) SELECT $6::bigint, 'conf-' || $9::text || '-' || gen_random_uuid()::text, 'saida', 'texto', $10::text WHERE $11::boolean RETURNING 1), tg AS (UPDATE mensagens SET processada_em = now() WHERE $13::text = 'id' AND contato_id = $6::bigint AND direcao = 'entrada' AND tipo = 'texto' AND processada_em IS NULL AND turno_id IS NULL AND conteudo IN ($14::text, $15::text) AND criado_em > now() - make_interval(secs => $16::int) RETURNING 1) SELECT 1 AS ok",
        "options": {
          "queryReplacement": "={{ (() => { const d = $('Desfecho').first().json; const env = $json.statusCode >= 200 && $json.statusCode < 300; return [d.id || null, !!d.liberar, d.falha ? d.falha.motivo : null, d.falha ? d.falha.code : null, d.falha ? d.falha.status : null, d.contato_id, d.idAgenda || null, !!d.recusada, d.code, d.texto || null, !!env || !!d.simulado, !!d.encerrar, $('Normalizar').first().json.origem, \"{{BV:mensagens.titulo_sim}}\", \"{{BV:mensagens.titulo_nao}}\", {{BV:mensagens.espera_texto_s}} * 2]; })() }}"
        }
      },
