    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT m.id, m.situacao, m.resposta, m.motivo, m.id_profissional, m.graces_agendamento_id, m.graces_cliente_id, to_char(m.inicio, 'YYYY-MM-DD\"T\"HH24:MI:SS') AS inicio, m.dados, c.telefone, (m.inicio > (now() AT TIME ZONE 'America/Sao_Paulo')) AS futuro, COALESCE(m.respondida_em > now() - make_interval(secs => $3::int), false) AS recente, (SELECT count(*) FROM mensagens r WHERE r.contato_id = m.contato_id AND r.direcao = 'saida' AND r.mensagem_id_canal LIKE 'conf-repetida-%' AND r.criado_em > now() - interval '1 hour') AS repetidas FROM mensagens_agendadas m JOIN contatos c ON c.id = m.contato_id WHERE m.contato_id = $1::bigint AND m.tipo = 'confirmacao' AND m.situacao IN ('enviada', 'cancelada', 'falhou') AND (m.id = $2::bigint OR ($2::bigint IS NULL AND m.situacao = 'enviada' AND m.inicio > (now() AT TIME ZONE 'America/Sao_Paulo') AND ((m.resposta IS NULL AND m.motivo IS NULL) OR m.respondida_em > now() - make_interval(secs => $3::int)))) ORDER BY m.enviada_em DESC NULLS LAST LIMIT 5",
