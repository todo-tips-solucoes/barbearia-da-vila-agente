    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH t AS (SELECT gen_random_uuid() AS u), alvo AS (SELECT id FROM mensagens WHERE contato_id = $1::bigint AND direcao = 'entrada' AND processada_em IS NULL AND (turno_id IS NULL OR turno_em < now() - interval '{{BV:lock.ttl_s}} seconds') ORDER BY criado_em, id FOR UPDATE SKIP LOCKED) UPDATE mensagens m SET turno_id = t.u, turno_em = now() FROM alvo, t WHERE m.id = alvo.id RETURNING m.id, m.tipo, m.conteudo, m.midia_url, m.criado_em, m.turno_id",
