    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH marca AS (INSERT INTO marcas_conteudo (contato_id, hash_conteudo) SELECT $1::bigint, sha256(convert_to($4::text, 'UTF8')) WHERE $2::text IS NULL AND $3::text = 'texto' ON CONFLICT (contato_id, hash_conteudo) DO UPDATE SET visto_em = now() WHERE marcas_conteudo.visto_em < now() - make_interval(secs => $6::int) RETURNING 1), ins AS (INSERT INTO mensagens (contato_id, mensagem_id_canal, direcao, tipo, conteudo, midia_url) SELECT $1::bigint, $2::text, 'entrada', $3::text, $4::text, $5::text WHERE $3::text <> 'texto' OR $2::text IS NOT NULL OR EXISTS (SELECT 1 FROM marca) ON CONFLICT (mensagem_id_canal) DO NOTHING RETURNING id) SELECT (SELECT id FROM ins) AS id, $1::bigint AS contato_id",
        "options": {
          "queryReplacement": "={{ [$json.contato_id, $('Normalizar').first().json.msg.idCanal, $('Normalizar').first().json.msg.tipo, $('Normalizar').first().json.msg.conteudo, $('Normalizar').first().json.msg.midiaUrl, {{BV:dedup.conteudo_janela_s}}] }}"
