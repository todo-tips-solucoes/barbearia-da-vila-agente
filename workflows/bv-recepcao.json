        "jsCode": "{{BV:INCLUDE:shared/rajada.js}}\nconst linhas = $input.all().map(i => i.json).filter(j => j.id != null);\nif (!linhas.length) return [{ json: { vazio: true } }];\nconst ord = consolidar(linhas);\nreturn [{ json: { vazio: false, turno_id: ord[0].turno_id, contato_id: $('Inserir mensagem').first().json.contato_id,\n  telefone: $('Normalizar').first().json.msg.telefone, total: ord.length,\n  itens: ord.map(l => ({ mensagem_id: Number(l.id), tipo: l.tipo, conteudo: l.conteudo, midia_url: l.midia_url, recebida_em: new Date(l.criado_em).toISOString() })) } }];"
